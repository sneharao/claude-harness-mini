# Claude Code OpenTelemetry — local OTLP collector
#
# Copy to .env (already gitignored) and source: `set -a; source .env; set +a`
# Docs: https://code.claude.com/docs/en/monitoring-usage.md

CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Traces (distributed spans) — beta. Uncomment the two lines below to opt in.
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
# OTEL_TRACES_EXPORTER=otlp
